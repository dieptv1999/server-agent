# API endpoint to report metrics to
API_URL=http://localhost:7001/dpm/v1
# Secret key shared with dpm-backend (SERVER_AGENT_SECRET)
SECRET=change-me-to-random-secret
# Human-readable name for this server (optional, falls back to hostname)
SERVER_NAME=web-01
# Optional PostgreSQL DSN for PG monitoring
DATABASE_URL=postgres://user:password@localhost:5432/postgres

# ---- Optional: UDP full-mesh link monitoring (agent <-> agent) ----
# Comma-separated peers as "name:ip" (name optional) or "ip".
# Leave empty to disable link monitoring entirely.
MONITOR_PEERS=web-02:10.0.0.2,db-01:10.0.0.3
# UDP port used to listen for and send heartbeats (default 9999)
HEARTBEAT_PORT=9999
# Heartbeat send interval in ms (default 1000)
HEARTBEAT_INTERVAL_MS=1000
# Mark a peer down after this much silence in ms (default 3000)
HEARTBEAT_TIMEOUT_MS=3000
# Summary keepalive interval in seconds (default 60)
HEARTBEAT_KEEPALIVE_S=60
# Extra confirmation window before reporting a peer down, in ms (default 5000)
HEARTBEAT_DOWN_CONFIRM_MS=5000
# Override auto-detected self IP advertised in heartbeats (optional)
# HEARTBEAT_SELF_IP=10.0.0.1
